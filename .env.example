# Copier en .env.local et renseigner. Aucune valeur réelle ici : ce fichier est versionné.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# stripe listen --print-secret (dev) ou dashboard Stripe (prod)
STRIPE_WEBHOOK_SECRET=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=

# ── Auth / e-mails ──────────────────────────────────────────────────────────
JWT_SECRET=
RESEND_API_KEY=

# ── Mesure d'audience & référencement ───────────────────────────────────────
# GA4 → Admin → Flux de données → identifiant « G-XXXXXXXXXX ».
# Vide = pas de script Google chargé, pas de bandeau cookies affiché.
NEXT_PUBLIC_GA_ID=
# Valeur du "content" de la balise meta fournie par Search Console.
GOOGLE_SITE_VERIFICATION=
# Idem pour Bing Webmaster Tools (msvalidate.01).
BING_SITE_VERIFICATION=
